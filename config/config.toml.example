data_dir = "/var/lib/liqwatch"

[collect]
venue = "binance"
map_path = "/etc/liqwatch/venue-map.toml"
metrics_addr = "127.0.0.1:9101"
pprof_addr = "" # Disabled when empty; use a trusted address, e.g. 127.0.0.1:6060.
extra_metrics_addrs = ["127.0.0.1:9102"]
open_spacing_ms = 500
max_streams_per_ws = 100
queue_size = 10000

[collect.throttle]
enabled = true # Set false to disable; override declared channels with e.g. "mark" = "1s".

[archive]
remote_root = "https://example.invalid/dav/ronigooja_onedrive/liqwatch/"
max_pack_mb = 400
verify_sample_percent = 10
full_verify_days = 7
max_kbps = 0

[pack]
unit = "tar_then_zstd"
level = 3
quiet_minutes = 10

[checks]
disk_warn_pct = 80
unverified_hours = 3

[checks.stale_sec]
aggTrade = 120
markPrice_all = 60
forceOrder_all = 0

[poller]
# map_path = "/etc/liqwatch/venue-map.toml" # defaults to collect.map_path
overlap = "2h"
initial_lookback = "2h" # Clamped to 29 days.

[poller.periods]
# openInterestHist = "24h"

# Per-venue poller settings; run one process per venue: liqwatch-poller -venue bybit.
# Universe: usable symbols of the venue in map_path (default collect.map_path); binance uses exchangeInfo.
# The top-level channel tables above (periods, rps, weights) and base_url apply to binance only.
[poller.venues.bybit]
rps = 2                  # requests per second per endpoint
weight_per_minute = 240  # request budget per minute
# base_url = "https://api.bybit.com"  # override the venue default, e.g. for tests
# overlap = "2h"
# initial_lookback = "2h"

[poller.venues.bybit.periods]
# openInterest = "24h"

[poller.venues.bybit.channel_rps]
# openInterest = 1
