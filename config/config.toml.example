data_dir = "/data/liqwatch"
# Recorder host: data_dir = "/var/lib/liqwatch/data" (root disk); [pack].dir = "/data/liqwatch-archive" (mounted HDD).

[record]
compress = false # Opt in to live zstd: .jsonl.zst; false preserves byte-identical plain JSONL.
level = 1 # zstd level 1..22; shared encoder, independent frames on buffer flush.
# flush = "30s" # Positive Go duration, <=5m, both recorders/modes. Unset: compressed 30s; plain collector 5s/poller 1s.

[collect]
venue = "binance"
map_path = "/etc/liqwatch/venue-map.toml"
metrics_addr = "127.0.0.1:9101"
pprof_addr = "" # Disabled when empty; use a trusted address, e.g. 127.0.0.1:6060.
extra_metrics_addrs = ["127.0.0.1:9102", "127.0.0.1:9103", "127.0.0.1:9104", "127.0.0.1:9105", "127.0.0.1:9106", "127.0.0.1:9107"]
open_spacing_ms = 500
max_streams_per_ws = 100
queue_size = 10000

[collect.throttle]
enabled = true # Set false to disable; override declared channels with e.g. "mark" = "1s".

[archive]
mode = "webdav" # Default; choose "local" for HDD-only verification, with no network or credentials.
delete_sources = true # Local only: false verifies/reports without deleting raw. WebDAV behavior is unchanged.
retention = true # Local only: capacity pruning deletes oldest packs, including the only copy; false disables.
retention_high_pct = 90 # Start pruning at >= high; zero is invalid, not a disable switch.
retention_low_pct = 80 # Stop after a whole day when usage <= low; 0 < low < high <= 99.
retention_max_days_per_run = 3 # Positive whole-day cap; usage still >= high produces WARNING and nonzero exit.
remote_root = "https://example.invalid/dav/ronigooja_onedrive/liqwatch/"
max_pack_mb = 400
verify_sample_percent = 10
full_verify_days = 7
max_kbps = 0 # 0 unlimited; local mode paces all physical verification reads with a 32 KiB burst.

[pack]
# dir = "/data/liqwatch-archive" # Absolute root for packs/ and manifest/; omitted or empty uses data_dir; pre-create owned by liqwatch.
unit = "tar_then_zstd"
level = 3
quiet_minutes = 10

[checks]
disk_warn_pct = 80
unverified_hours = 3

[checks.stale_sec]
aggTrade = 120
markPrice_all = 60
forceOrder_all = 0

[poller]
# map_path = "/etc/liqwatch/venue-map.toml" # defaults to collect.map_path
overlap = "2h"
# initial_lookback = "0s" # Deprecated compatibility setting; live recording always starts at its persisted first-start time.

[poller.periods]
# openInterestHist = "24h"

# Per-venue poller settings; run one process per venue: liqwatch-poller -venue bybit.
# Universe: usable symbols of the venue in map_path (default collect.map_path); binance uses exchangeInfo.
# The top-level channel tables above (periods, rps, weights) and base_url apply to binance only.
[poller.venues.bybit]
rps = 2                  # requests per second per endpoint
weight_per_minute = 240  # request budget per minute
# base_url = "https://api.bybit.com"  # override the venue default, e.g. for tests
# overlap = "2h"
# initial_lookback = "0s" # Deprecated; does not widen live recording scope.

[poller.venues.bybit.periods]
# openInterest = "24h"

[poller.venues.bybit.channel_rps]
# openInterest = 1
