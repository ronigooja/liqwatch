[Unit]
Description=Wicker collector slot %i
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
User=wicker
ExecStart=${WICKER_BIN} -config /etc/wicker/config.toml -instance %i -metrics-addr ${WICKER_METRICS_ADDR}
EnvironmentFile=/etc/wicker/slot-%i.env
Restart=always
RestartSec=1s
TimeoutStopSec=60s
LimitNOFILE=65536
MemoryMax=2500M
CPUQuota=150%

[Install]
WantedBy=multi-user.target
