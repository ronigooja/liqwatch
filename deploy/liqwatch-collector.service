[Unit]
Description=Liqwatch collector
RequiresMountsFor=/data/liqwatch
ConditionPathIsMountPoint=/data/liqwatch
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
User=liqwatch
ExecStart=/opt/liqwatch/current/liqwatch-collector -config /etc/liqwatch/config.toml
Restart=always
RestartSec=5s
LimitNOFILE=65536
MemoryMax=192M

[Install]
WantedBy=multi-user.target
