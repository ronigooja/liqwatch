[Unit]
Description=Liqwatch venue poller %i
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/var/lib/liqwatch
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
User=liqwatch
ExecStart=/opt/liqwatch/current/liqwatch-poller -config /etc/liqwatch/config.toml -venue %i
Restart=always
RestartSec=5s
TimeoutStopSec=60s
LimitNOFILE=65536
MemoryMax=128M

[Install]
WantedBy=multi-user.target
