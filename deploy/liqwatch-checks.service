[Unit]
Description=Run liqwatch health checks
RequiresMountsFor=/data/liqwatch-archive /var/lib/liqwatch
ConditionPathIsMountPoint=/data/liqwatch-archive

[Service]
Type=oneshot
User=liqwatch
MemoryMax=64M
StandardError=journal
ExecStart=/opt/liqwatch/current/liqwatch-checks -config /etc/liqwatch/config.toml
