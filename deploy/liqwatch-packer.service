[Unit]
Description=Liqwatch daily packer
RequiresMountsFor=/data/liqwatch-archive /var/lib/liqwatch
ConditionPathIsMountPoint=/data/liqwatch-archive

[Service]
Type=oneshot
User=liqwatch
MemoryMax=512M
ExecStart=/opt/liqwatch/current/liqwatch-packer -config /etc/liqwatch/config.toml
Nice=15
IOSchedulingClass=idle
